DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=<SERVER_IP>,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://<SERVER_IP>

# PostgreSQL (the db container reads these)
POSTGRES_DB=flame
POSTGRES_USER=flame
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://flame:change-me@db:5432/flame

# Redis
REDIS_URL=redis://redis:6379/0

# Claude API
ANTHROPIC_API_KEY=sk-ant-your-key
CLAUDE_MODEL_FAST=claude-sonnet-5-5
CLAUDE_MODEL_DEEP=claude-opus-5-5
CLAUDE_MODEL_FRONTIER=claude-opus-5-5
AI_DAILY_TOKEN_LIMIT=5000000

# Data source
PSI_BASE_URL=https://psi.nasa.gov/physci/repo

# Error monitoring (optional, leave empty to turn off)
SENTRY_DSN=
